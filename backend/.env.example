# Existing OPENAI_API_KEY is also accepted. Keep keys server-side only.
# REMIND_OPENAI_API_KEY=your-key
REMIND_OPENAI_TEXT_MODEL=gpt-4.1-mini
REMIND_OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
REMIND_DATA_DIR=.local
# Uncalibrated operating defaults. Evaluate on held-out encounter recordings.
REMIND_MATCH_THRESHOLD=0.55
REMIND_MATCH_MARGIN=0.08
REMIND_VOICE_USER_THRESHOLD=0.65
REMIND_VOICE_VISITOR_THRESHOLD=0.35
REMIND_VOICE_ENROLLMENT_THRESHOLD=0.55
REMIND_VOICE_MIN_SPEECH_SECONDS=1.5
REMIND_VOICE_THREADS=2
REMIND_MEMORY_TIMEZONE=Asia/Ho_Chi_Minh
REMIND_VISION_THREADS=4
REMIND_SPOOL_LIMIT_BYTES=1073741824

# Local temporary conversation media (default 24 hours)
REMIND_MEDIA_RETENTION_SECONDS=86400
