# Remind Backend — single-patient, patient-owned configuration.
# Copy to .env and fill in values. After dropping a caregiver/auth release, only
# fields defined in src/core/config.py Settings are honored; unknown keys are
# ignored by pydantic-settings (and the old JWT/ALLOW_BOOTSTRAP_ADMIN keys have
# been removed here so a fresh install won't trip SettingsError).

APP_NAME=Remind Backend
ENVIRONMENT=development
API_PREFIX=/api/v1

# PostgreSQL — connect to the host's pgvector-enabled Postgres 17 (no docker
# container needed for the DB). Run once before first migrate:
#   PGPASSWORD=remind psql -h localhost -U remind -d remind \
#     -c "CREATE EXTENSION IF NOT EXISTS vector;"
DATABASE_URL=postgresql+asyncpg://remind:remind@localhost:5432/remind

# OpenAI — required for live speech-to-text, memory extraction, and embeddings.
# Leave OPENAI_API_KEY empty to disable transcription + extraction (face
# recognition and interaction detection still run).
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# CompreFace — required for face recognition/enrollment. Leave COMPREFACE_API_KEY
# empty to disable face recognition (interactions still tracked by audio only).
COMPREFACE_BASE_URL=http://localhost:8000
COMPREFACE_API_KEY=

# Identity confidence thresholds (recognition_status escalates with similarity).
IDENTITY_HIGH_CONFIDENCE=0.95
IDENTITY_MEDIUM_CONFIDENCE=0.80
IDENTITY_RECOGNIZED_CONFIDENCE=0.60

# Captured evidence storage on disk (audio/video snippets tied to interactions).
EVIDENCE_STORAGE_DIR=.local/evidence
EVIDENCE_RETENTION_DAYS=30

# Live interaction detector tuning.
LIVE_FRAME_SAMPLE_INTERVAL_MS=500
LIVE_INTERACTION_CANDIDATE_SCORE=0.45
LIVE_INTERACTION_ACTIVE_SCORE=0.70
LIVE_INTERACTION_MIN_CANDIDATE_MS=2000
LIVE_INTERACTION_END_SILENCE_MS=8000
LIVE_AUDIO_SAMPLE_RATE_HZ=16000
LIVE_AUDIO_VAD_MODE=2
LIVE_AUDIO_UTTERANCE_MAX_MS=12000

# Allowed browser origins. JSON list format is required by pydantic-settings v2's
# DotEnvSettingsSource; the comma-separated form will fail to parse.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
