APP_NAME=Remind Backend
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://remind:remind@localhost:5432/remind
JWT_SECRET=change-me-in-production
JWT_ISSUER=remind-backend
ACCESS_TOKEN_MINUTES=720
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
COMPREFACE_BASE_URL=http://localhost:8000
COMPREFACE_API_KEY=
IDENTITY_HIGH_CONFIDENCE=0.95
IDENTITY_MEDIUM_CONFIDENCE=0.80
IDENTITY_SEEN_BEFORE_CONFIDENCE=0.60
EVIDENCE_STORAGE_DIR=.local/evidence
EVIDENCE_RETENTION_DAYS=30
ALLOW_BOOTSTRAP_ADMIN=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
